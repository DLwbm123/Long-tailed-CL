{
    "name": "iNaturalist_ResNet50",
    "n_gpu": 4,

    "arch": {
        "type": "DERM_ResNet50Model",
        "args": {
            "num_classes": 8142,
            "reduce_dimension": false,
            "use_norm": true,
            "returns_feat": true,
            "num_experts": 3,
            "share_layer3": true
        }
    },
    "data_loader": {
        "type": "iNaturalistDataLoader",
        "args":{
            "data_dir": "/data/dataset/iNaturalist18",
            "batch_size": 256,
            "shuffle": true,
            "num_workers": 16
        }
    },
    "optimizer": {
        "type": "SGD",
        "args":{
            "lr": 0.1,
            "controller_lr": 1e-4,
            "weight_decay": 2e-4,
            "momentum": 0.9,
            "nesterov": true
    }
},
    "add_extra_info": true,
    "loss": {
        "type": "BSExpertLoss",
        "tau_min": -1.0,
        "tau_max": 3.0,
        "args": {
            "tau_list": [-1.0, 1.0, 3.0]
        }
    },
    "metrics": [
        "accuracy"
    ],
    "lr_scheduler": {
        "type": "CosineAnnealingLR",
        "args": {
            "T_max": 100,
            "eta_min": 0.0
        }
    },
    "trainer": {
        "epochs": 100,
        "save_dir": "saved/inaturalist/bs_e100_tau1_bs512_lr0.2",
        "save_period": 100,
        "verbosity": 2,
        "monitor": "max val_accuracy",
        "validate": true,

        "amuse_cfg": {
            "lambda_decouple": 0.1,
            "lambda_diversity": 0.1,
            "loss_warmup_epochs": 10,
            "diversity_temp": 1.0,
            "ema_momentum": 0.9,
            "gate_decision": {
                "update_every_epochs": 1,
                "update_mechanism": "unc_map",
                "alpha": 2.0,
                "beta": 1.0,
                "gamma": 0.0
            }
        }
    },
    "combiner": {
        "type": "Combiner",
        "mode": "mixup",
        "mixup": {
            "alpha": 0.2
        }
    }
}

