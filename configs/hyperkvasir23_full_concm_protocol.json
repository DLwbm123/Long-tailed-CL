{
  "dataset": "hyper_kvasir23",
  "order": "shuffled",
  "base_classes": 13,
  "incremental_steps": 5,
  "modes": [
    "locked_nc",
    "full_dynamic",
    "nc_anchored"
  ],
  "seeds": [
    1,
    2,
    3
  ],
  "projector_hidden": 2048,
  "projector_dim": 128,
  "base_projector_epochs": 5,
  "increment_projector_epochs": 5,
  "projector_lr": 0.01,
  "mpc_k_shot": 5,
  "mpc_epochs": 20,
  "mpc_lr": 0.01,
  "mpc_alpha": 0.75,
  "covariance_gamma": 16.0,
  "covariance_beta": 0.6,
  "sample_num_old": 100,
  "sample_num_current": 50,
  "temperature": 0.07,
  "lambda_dsm": 0.2,
  "optimizer_rule": "Rebuild SGD and cosine scheduler per session; inherit projector and MPC weights.",
  "semantic_embedding": "deterministic_signed_hash_fallback",
  "gpu_contract": "PHYSICAL_GPU=1 and CUDA_VISIBLE_DEVICES=1; strictly serial"
}
