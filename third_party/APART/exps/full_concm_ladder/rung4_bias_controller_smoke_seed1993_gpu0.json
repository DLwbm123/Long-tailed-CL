{
    "prefix": "reproduce",
    "dataset": "cifar224",
    "memory_size": 0,
    "memory_per_class": 0,
    "fixed_memory": false,
    "shuffle": true,
    "init_cls": 50,
    "increment": 10,
    "model_name": "apart",
    "backbone_type": "vit_b16_224_adapter_pool",
    "get_original_backbone": true,
    "device": ["0"],
    "seed": [1993],
    "freeze": ["blocks", "patch_embed", "cls_token", "norm", "pos_embed"],

    "tuned_epoch": 2,
    "init_lr": 0.003,
    "batch_size": 48,
    "weight_decay": 0,
    "min_lr": 1e-5,
    "ffn_num": 64,
    "vpt_type": "shallow",
    "prompt_token_num": 5,
    "optimizer": "adamw",
    "scheduler": "constant",
    "reinit_optimizer": true,

    "pretrained": true,
    "drop": 0.0,
    "drop_path": 0.0,

    "sep": true,
    "prompt_pool": true,
    "size": 10,
    "pool_size": 5,
    "top_k": 1,
    "initializer": "uniform",
    "prompt_key": true,
    "prompt_key_init": "uniform",
    "use_prompt_mask": false,
    "shared_prompt_pool": false,
    "shared_prompt_key": false,
    "batchwise_prompt": true,
    "embedding_key": "cls",
    "predefined_key": "",
    "pull_constraint": true,
    "pull_constraint_coeff": 0.1,
    "imbalance": true,
    "longtail": 0.01,
    "order": false,
    "theta": 100,

    "concm_stage1": true,
    "concm_stage1_loss_weight": 0.05,
    "concm_stage1_synth_per_class": 4,
    "concm_stage1_cov_eps": 1e-6,
    "concm_stage1_var_max": 1.0,
    "concm_stage1_start_epoch": 1,
    "concm_stage1_ramp_epochs": 0,
    "concm_stage1_max_synth_total": 48,
    "max_tasks": 2,

    "concm_stage1_eval_calibration": true,
    "calibration_rule": "head_norm_effective_sum",

    "concm_replay_bias_controller": true,
    "concm_replay_target_bias": 0.12,
    "concm_replay_min_scale": 0.5,
    "concm_replay_max_scale": 1.0,
    "concm_replay_bias_eps": 1e-6,

    "concm_proto_calibration": false,

    "concm_use_match_loss": false,
    "concm_match_lambda": 0.01,
    "concm_match_warmup_epoch": 5,
    "concm_match_paths": "both",
    "concm_match_detach_anchors": true,
    "concm_match_current_only": true,
    "concm_match_tail_weight": false
}
